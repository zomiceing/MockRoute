<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MockRoute — PC 脚本驱动的虚拟定位"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 虚拟定位开关状态：一眼就能看出当前是开还是关 -->
    <TextView
        android:id="@+id/tvSwitchState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="14dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#2A2A2A"
        android:textColor="#AAAAAA"
        android:text="虚拟定位：已关闭" />

    <!-- 关闭虚拟定位：主操作，单独占一行、按钮尺寸放大 -->
    <Button
        android:id="@+id/btnMockOff"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:textSize="17sp"
        android:text="关闭虚拟定位（恢复真实 GPS）" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnMockOn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="重新开启" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="自检" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:text="等待指令…" />
</LinearLayout>
